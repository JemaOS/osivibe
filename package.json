{
  "name": "osivibe",
  "private": true,
  "version": "0.0.0",
  "description": "Browser-based video editor with timeline editing, transitions, effects, text and hardware-accelerated export — no install, no upload.",
  "keywords": [
    "video-editor",
    "online-video-editor",
    "browser-video-editor",
    "timeline",
    "transitions",
    "effects",
    "text",
    "titles",
    "export",
    "mp4",
    "webm",
    "mediabunny",
    "pwa",
    "offline",
    "react",
    "typescript",
    "tailwindcss"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && BUILD_MODE=prod vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:perf:export": "playwright test tests/performance/export.spec.ts",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm test && npm run test:e2e",
    "audit": "npm audit",
    "install-deps": "npm install",
    "clean": "rm -rf node_modules package-lock.json"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.364.0",
    "mediabunny": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.12.0",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.30",
    "tailwindcss": "v3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-source-identifier": "1.1.2",
    "vitest": "^4.0.15",
    "workbox-window": "^7.4.1"
  }
}
